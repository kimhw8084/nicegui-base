      "command": "/bin/zsh -lc \"rtk python3 - <<'PY'\nimport os\nfrom urllib.parse import urlsplit\nfrom pip._internal.configuration import Configuration\n\nURL_KEYS = {'PIP_INDEX_URL', 'PIP_EXTRA_INDEX_URL', 'PIP_FIND_LINKS'}\n\ndef safe_endpoint(value):\n    if not value:\n        return 'ABSENT'\n    parts = str(value).split()\n    safe = []\n    for item in parts:\n        parsed = urlsplit(item)\n        if parsed.scheme and parsed.hostname:\n            host = parsed.hostname\n            port = f':{parsed.port}' if parsed.port else ''\n            safe.append(f'{parsed.scheme}://{host}{port}')\n        else:\n            safe.append('<non-url-path>')\n    return ' '.join(safe)\n\ndef safe_scalar(value):\n    if value is None:\n        return 'ABSENT'\n    text = str(value)\n    return f'<set length={len(text)}>'\n\nprint('INHERITED_PIP_ENVIRONMENT')\nfor name in sorted(k for k in os.environ if k.startswith('PIP_')):\n    value = os.environ.get(name)\n    if name in URL_KEYS:\n        print(f'{name}: {safe_endpoint(value)}')\n    else:\n        print(f'{name}: {safe_scalar(value)}')\n\ncfg = Configuration(isolated=False)\ncfg.load()\nprint('PIP_CONFIGURATION_FILES')\nfor variant, path in cfg.iter_config_files():\n    print(f'{variant}: {path}')\n\nprint('EFFECTIVE_RELEVANT_CONFIGURATION')\nfor key in (\n    'global.index-url', 'install.index-url',\n    'global.extra-index-url', 'install.extra-index-url',\n    'global.find-links', 'install.find-links',\n):\n    try:\n        value = cfg.get_value(key)\n    except Exception as exc:\n        value = f'<unreadable:{type(exc).__name__}>'\n    if 'index-url' in key or 'find-links' in key:\n        rendered = safe_endpoint(value)\n    else:\n        rendered = safe_scalar(value)\n    print(f'{key}: {rendered}')\nPY\"",
